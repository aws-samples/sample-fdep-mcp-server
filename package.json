{
  "name": "fdep-kit",
  "version": "0.3.2",
  "type": "module",
  "description": "AI Native Enterprise Toolkit — harness-agnostic enablement toolkit",
  "bin": {
    "fdep-mcp": "./bin/fdep-mcp.mjs"
  },
  "main": "./core/dist/index.js",
  "types": "./core/dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "npm --prefix web run build:demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint \"core/**/*.ts\" \"adapters/**/*.ts\"",
    "scan:secrets": "node core/dist/core/src/security/secrets-scan-cli.js",
    "scan:portability": "node core/dist/core/src/security/portability-scan-cli.js",
    "precommit": "npm run typecheck && npm run lint && npm run scan:secrets && npm run scan:portability && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "handlebars": "4.7.9",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "fast-check": "3.23.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "workspaces": [
    "core"
  ]
}
